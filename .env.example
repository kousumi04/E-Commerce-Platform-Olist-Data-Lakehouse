# ==========================================
# RetailPulse Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to GitHub.
# ==========================================

# AWS Authentication (Use AWS CLI named profile - never hardcode keys)
AWS_PROFILE=retailpulse-dev
AWS_REGION=ap-south-1

# Amazon S3 Data Lake
S3_BUCKET_NAME=retailpulse-data-lake-yourname
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/
S3_CURATED_PREFIX=curated/

# Amazon Athena
ATHENA_DATABASE=retailpulse_dw
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://retailpulse-data-lake-yourname/athena-results/

# Local Pipeline Paths
DATASET_PATH=data/raw
PROCESSED_PATH=data/processed
CURATED_PATH=data/curated

# Logging
LOG_LEVEL=INFO